  templateTasks       TemplateTask[]
  templateZoneTasks   TemplateZoneTask[]
  projectDeliverables ProjectDeliverable[]

  @@map("phases")
}

// ─── Tasks ─────────────────────────────────────────────────────────────────

model Task {
  id                    Int          @id @default(autoincrement())
  // Tasks can attach directly to a project (zoneId = null) — used for
  // project-level deliverables/tasks that aren't tied to a spatial zone.
  // The planning grid renders these in a "Project Root" group above any
  // zoned tasks. Cascade-delete still fires for zone deletion since the
  // FK is the relation, not this scalar — the relation below is now
  // optional and uses SetNull semantics via Prisma.
  zoneId                Int?         @map("zone_id")
  // Project is now OPTIONAL to support "personal tasks" — a task an
  // employee opens for themselves that isn't tied to any project /
  // zone / service / deliverable. Personal tasks show in My Tasks +
  // time reports but do NOT affect any Deliverable's completion %.
  // If a personal task happens to be linked to a Project/Deliverable,
  // its hours still roll into that project/deliverable's totals but
  // it doesn't block the Deliverable's completion. (Tier D #1,
  // 2026-06-30.)
  projectId             Int?         @map("project_id")
  isPersonal            Boolean      @default(false) @map("is_personal")
  // Optional Review step (Tier D #2). When false, in_progress can
  // transition directly to completed without passing through
  // in_review — used by tasks that don't need a second-eye check.
  requiresReview        Boolean      @default(true) @map("requires_review")
  /// True when someone with permission (assignee / their managers) has
  /// manually changed endDate away from the Deliverable's target date.
  /// While this flag is true, a Deliverable date change WON'T
  /// silently overwrite this task's endDate — the UI prompts the PM
  /// to decide "keep manual dates" vs "overwrite from new target".
  /// (Tier E #10 revision, 2026-08-02.)
  dueDateOverridden     Boolean      @default(false) @map("due_date_overridden")
  serviceTypeId         Int?         @map("service_type_id")
  // Source Deliverable (Template with type=task_list). Direct FK so
  // the planning grid's "Group by Deliverable" can label cards by the
  // same name shown on /templates/deliverables. ServiceType is kept
  // alongside as a legacy fallback for tasks that pre-date this column.
  deliverableTemplateId Int?         @map("deliverable_template_id")
  // Project-owned deliverable (first-class instance). This is the
  // AUTHORITATIVE link going forward — its name/order/status belong to
  // the project (and are what the PM and customer see). deliverableTemplateId
  // is kept as the catalog provenance + back-compat for legacy readers.
  projectDeliverableId  Int?         @map("project_deliverable_id")
  code                  String       @db.VarChar(50)
  name                  String       @db.VarChar(255)
  description           String?      @db.Text
  budgetHours           Decimal?     @map("budget_hours") @db.Decimal(10, 2)
  budgetAmount          Decimal?     @map("budget_amount") @db.Decimal(14, 2)
  phaseId               Int?         @map("phase_id")
  status                TaskStatus   @default(not_started)
  priority              TaskPriority @default(medium)
  completionPct         Int          @default(0) @map("completion_pct")
  // Estimated start date — forecast set during planning, separate from
  // startDate (which is the *actual* date work began).
  estimatedStartDate    DateTime?    @map("estimated_start_date") @db.Date
  startDate             DateTime?    @map("start_date") @db.Date
  endDate               DateTime?    @map("end_date") @db.Date
  sortOrder             Int          @default(0) @map("sort_order")
  isArchived            Boolean      @default(false) @map("is_archived")
  createdBy             Int          @map("created_by")
  createdAt             DateTime     @default(now()) @map("created_at")
  updatedAt             DateTime     @updatedAt @map("updated_at")
  deletedAt             DateTime?    @map("deleted_at")

  zone                Zone?               @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  project             Project?            @relation(fields: [projectId], references: [id])
  serviceType         ServiceType?        @relation(fields: [serviceTypeId], references: [id])
  phase               Phase?              @relation(fields: [phaseId], references: [id])
  deliverableTemplate Template?           @relation("TaskDeliverableTemplate", fields: [deliverableTemplateId], references: [id], onDelete: SetNull)
  projectDeliverable  ProjectDeliverable? @relation(fields: [projectDeliverableId], references: [id], onDelete: SetNull)
  creator             User                @relation("TaskCreator", fields: [createdBy], references: [id])
  assignees           TaskAssignee[]
  comments            TaskComment[]
  attachments         TaskAttachment[]
  timeEntries         TimeEntry[]
  dependencies        TaskDependency[]    @relation("TaskDeps")
  dependedBy          TaskDependency[]    @relation("TaskDepBy")
  checklistItems      TaskChecklistItem[]
  reviewEvents        TaskReviewEvent[]
  opsNote             TaskOpsNote?
  projectFiles        ProjectFile[]

  @@index([zoneId])
  @@index([projectId])
  @@index([serviceTypeId])
  @@index([projectDeliverableId])
  @@index([status])
  @@index([isPersonal])
  @@map("tasks")
}

/// Persisted record of every task-review action — submit, approve,
/// return-for-revisions. Feeds the "review analytics" dashboards the
/// user asked for: how many returns per task, which manager is
/// strictest, who never reviews. Kept separate from activity_logs
/// because reviews need typed fields (result, reason) that an
/// activity-log payload would flatten. (Tier D #2a, 2026-06-30.)
model TaskReviewEvent {
  id        Int      @id @default(autoincrement())
  taskId    Int      @map("task_id")
  actorId   Int      @map("actor_id")
  action    String   @db.VarChar(32) // 'submit' | 'approve' | 'return'
  reason    String?  @db.Text // return notes / feedback
  createdAt DateTime @default(now()) @map("created_at")

  task  Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor User @relation("TaskReviewActor", fields: [actorId], references: [id])

  @@index([taskId, createdAt])
  @@index([actorId, createdAt])
  @@map("task_review_events")
}

/// Checklist items inside a Task. Per the 2026-06-14 BM mapping meeting
/// these are NOT separate tasks — no due date, no logged hours, no
/// status workflow. Just a list of things to tick off as the task
/// progresses (the "phone the architect; send the updated grid; verify
/// permits" sublist style). doneBy/doneAt are populated when isDone
/// flips to true so the team can see WHO actually closed each item.
model TaskChecklistItem {
  id        Int       @id @default(autoincrement())
  taskId    Int       @map("task_id")
  text      String    @db.VarChar(500)
  isDone    Boolean   @default(false) @map("is_done")
  doneAt    DateTime? @map("done_at")
  doneBy    Int?      @map("done_by")
  sortOrder Int       @default(0) @map("sort_order")
  createdBy Int       @map("created_by")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  task       Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  doneByUser User? @relation("ChecklistDoneBy", fields: [doneBy], references: [id], onDelete: SetNull)
  creator    User  @relation("ChecklistCreator", fields: [createdBy], references: [id])

  @@index([taskId])
  @@index([deletedAt])
  @@map("task_checklist_items")
}

/// A project-owned Deliverable instance. Instantiated from a catalog
/// Template (sourceTemplateId) but its name/description/order/status
/// belong to the project — this is what the PM manages and the customer
/// sees. The catalog Template is never mutated; the project instance
/// diverges freely. Tasks link here via Task.projectDeliverableId.
model ProjectDeliverable {
  id                     Int       @id @default(autoincrement())
  projectId              Int       @map("project_id")
  /// Catalog Template (type=task_list) this was instantiated from. Null
  /// for project-only deliverables with no catalog source.
  sourceTemplateId       Int?      @map("source_template_id")
  /// The Service (Phase) line this deliverable belongs to. Inherited from
  /// the source template's phase; editable per project.
  serviceId              Int?      @map("service_id")
  name                   String    @db.VarChar(255)
  description            String?   @db.Text
  sortOrder              Int       @default(0) @map("sort_order")
  status                 String    @default("active") @db.VarChar(30)
  /// Deliverable Planning target date (Tier E #10). Set on the
  /// "Deliverable Planning" page as N months from a base date; the
  /// backend snaps to the first day of that week and stores it as an
  /// absolute date. Nullable — deliverables without a target date
  /// simply don't render a bar on the Gantt.
  targetDate             DateTime? @map("target_date") @db.Date
  /// Convenience — the relative-offset value the PM typed. Kept so we
  /// can render "in N months from base" alongside the computed date.
  targetMonths           Int?      @map("target_months")
  /// Deliverable-level default estimated duration in CALENDAR days.
  /// Used as the fallback when a (zone × deliverable) row doesn't
  /// override it. (2026-08-02.)
  estimatedDurationWeeks Int?      @map("estimated_duration_weeks")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")
  deletedAt              DateTime? @map("deleted_at")

  project        Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceTemplate Template?               @relation("DeliverableSourceTemplate", fields: [sourceTemplateId], references: [id], onDelete: SetNull)
  service        Phase?                  @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  tasks          Task[]
  zoneTargets    ZoneDeliverableTarget[]
  projectFiles   ProjectFile[]

  @@index([projectId])
  @@index([sourceTemplateId])
  @@map("project_deliverables")
}

/// Per-(zone × deliverable) target date + estimated duration for the
/// Deliverable Planning screen (Tier E #10, revised 2026-08-02).
/// Same deliverable can appear in multiple zones and each zone can have
/// its own delivery date and its own estimated duration. The
/// ProjectDeliverable-level fields stay as a fallback.
///
/// estimatedDurationDays is CALENDAR days (not working hours). The Gantt
/// draws the bar backward from the target date by this many days.
model ZoneDeliverableTarget {
  id                     Int       @id @default(autoincrement())
  zoneId                 Int       @map("zone_id")
  projectDeliverableId   Int       @map("project_deliverable_id")
  targetDate             DateTime? @map("target_date") @db.Date
  targetMonths           Int?      @map("target_months")
  /// Estimated calendar days for this (zone × deliverable). Used by the
  /// Gantt to draw start = target − N days. (2026-08-02.)
  estimatedDurationWeeks Int?      @map("estimated_duration_weeks")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  zone               Zone               @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  projectDeliverable ProjectDeliverable @relation(fields: [projectDeliverableId], references: [id], onDelete: Cascade)

  @@unique([zoneId, projectDeliverableId])
  @@index([projectDeliverableId])
  @@map("zone_deliverable_targets")
}

model TaskAttachment {
  id         Int      @id @default(autoincrement())
  taskId     Int      @map("task_id")
  /// Optional FK to TaskComment. When set the attachment was uploaded as
  /// part of a Discussion comment (rendered as chips below that comment).
  /// When null it's a task-level attachment shown in the drawer's Files
  /// section. Reusing one table avoids forking the upload pipeline.
  commentId  Int?     @map("comment_id")
  fileName   String   @map("file_name") @db.VarChar(255)
  fileUrl    String   @map("file_url") @db.VarChar(500)
  fileSize   Int?     @map("file_size")
  mimeType   String?  @map("mime_type") @db.VarChar(100)
  uploadedBy Int      @map("uploaded_by")
  createdAt  DateTime @default(now()) @map("created_at")

  task     Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  comment  TaskComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  uploader User         @relation(fields: [uploadedBy], references: [id])

  @@index([taskId])
  @@index([commentId])
  @@map("task_attachments")
}

enum ProjectFileKind {
  upload
  link
  /// Google Drive file referenced by fileId (stored in `url`) — the file
  /// LIVES in the customer's Shared Drive. Planwise stores metadata + the
  /// deep-link but never a byte of content. Access is authorised on the
  /// Google side via Shared-Drive membership; Planwise does NOT manage
  /// per-file permissions. See modules/drive/drive.service.ts.
  drive
}

model ProjectFile {
  id            Int             @id @default(autoincrement())
  projectId     Int             @map("project_id")
  kind          ProjectFileKind
  name          String          @db.VarChar(255)
  url           String          @db.VarChar(1000)
  fileSize      Int?            @map("file_size")
  mimeType      String?         @map("mime_type") @db.VarChar(100)
  description   String?         @db.Text
  /// For `drive`-kind rows: the Drive `webViewLink` returned by
  /// files.get — the user-facing URL to open the file in Drive UI.
  /// Nullable because Drive occasionally omits it for shortcuts; the
  /// client falls back to `https://drive.google.com/file/d/{url}/view`
  /// (where `url` is the fileId).
  webViewLink   String?         @map("web_view_link") @db.VarChar(1000)
  /// Optional task the file is attached to (for `drive` / task-scope
  /// files). ProjectFile stays the union type — task attachments used
  /// to live only in TaskAttachment (uploads), but Drive links use
  /// this column so the Files tab can list them alongside project
  /// files. When null, the file is project-level.
  taskId        Int?            @map("task_id")
  /// Optional deliverable the file is attached to. When set, the file
  /// is displayed on the deliverable's page. Independent of `taskId`
  /// (a file can belong to a deliverable without a task).
  deliverableId Int?            @map("deliverable_id")
  uploadedBy    Int             @map("uploaded_by")
  createdAt     DateTime        @default(now()) @map("created_at")

  project     Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task        Task?               @relation(fields: [taskId], references: [id], onDelete: SetNull)
  deliverable ProjectDeliverable? @relation(fields: [deliverableId], references: [id], onDelete: SetNull)
  uploader    User                @relation(fields: [uploadedBy], references: [id])

  @@index([projectId])
  @@index([taskId])
  @@index([deliverableId])
  @@map("project_files")
}

model TaskDependency {
  id          Int @id @default(autoincrement())
  taskId      Int @map("task_id")
  dependsOnId Int @map("depends_on_id")

  task      Task @relation("TaskDeps", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn Task @relation("TaskDepBy", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnId])
  @@index([taskId])
  @@index([dependsOnId])
  @@map("task_dependencies")
}

model TaskAssignee {
  id         Int       @id @default(autoincrement())
  taskId     Int       @map("task_id")
  userId     Int       @map("user_id")
  role       String?   @db.VarChar(50)
  hourlyRate Decimal?  @map("hourly_rate") @db.Decimal(10, 2)
  startDate  DateTime? @map("start_date") @db.Date
  endDate    DateTime? @map("end_date") @db.Date
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@unique([taskId, userId])
  @@map("task_assignees")
}

model TaskComment {
  id        Int       @id @default(autoincrement())
  taskId    Int       @map("task_id")
  userId    Int       @map("user_id")
  parentId  Int?      @map("parent_id")
  content   String    @db.Text
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  task        Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id])
  parent      TaskComment?     @relation("CommentThread", fields: [parentId], references: [id])
  replies     TaskComment[]    @relation("CommentThread")
  attachments TaskAttachment[]

  @@index([taskId])
  @@map("task_comments")
}

/// Operations-review annotation. One-per-task free-text note editable from
/// the Executive Review tab in the Operations dashboard. Kept separate
/// from TaskComment because TaskComment is a threaded discussion (many
/// per task, with mentions/attachments/replies) whereas the Executive
/// Review "Comment" column is a single, always-latest per-task
/// annotation the ops manager updates in place. Cascade-deleted with
/// the parent task. (feat/ops-complete, 2026-08.)
model TaskOpsNote {
  id        Int      @id @default(autoincrement())
  taskId    Int      @unique @map("task_id")
  content   String   @db.Text
  updatedBy Int      @map("updated_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  task          Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  updatedByUser User @relation("TaskOpsNoteUpdater", fields: [updatedBy], references: [id])

  @@index([updatedBy])
  @@map("task_ops_notes")
}

// ─── Templates ─────────────────────────────────────────────────────────────

model Template {
  id          Int          @id @default(autoincrement())
  code        String       @db.VarChar(50)
  name        String       @db.VarChar(255)
  type        TemplateType
  category    String?      @db.VarChar(100)
  description String?      @db.Text
  phaseId     Int?         @map("phase_id")
  isActive    Boolean      @default(true) @map("is_active")
  usageCount  Int          @default(0) @map("usage_count")
  createdBy   Int          @map("created_by")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  deletedAt   DateTime?    @map("deleted_at")

  creator             User                 @relation("TemplateCreator", fields: [createdBy], references: [id])
  phase               Phase?               @relation(fields: [phaseId], references: [id])
  templateTasks       TemplateTask[]
  templateZones       TemplateZone[]
  linkedZones         TemplateZone[]       @relation("LinkedTaskTemplate")
  referencedByZones   TemplateZone[]       @relation("ReferencedZoneTemplate")
  // Project tasks materialized from this Template — back-relation for
  // Task.deliverableTemplate. Enables COUNT-by-deliverable and "where
  // is this template used" queries without scanning Tasks globally.
  projectTasks        Task[]               @relation("TaskDeliverableTemplate")
  // Per-project deliverable instances materialized from this catalog
  // template. The catalog template stays untouched; each ProjectDeliverable
  // may diverge (rename, reorder, status) without affecting the catalog.
  projectDeliverables ProjectDeliverable[] @relation("DeliverableSourceTemplate")

  @@map("templates")
}

model TemplateTask {
  id                  Int          @id @default(autoincrement())
  templateId          Int          @map("template_id")
  serviceTypeId       Int?         @map("service_type_id")
  code                String       @db.VarChar(50)
  name                String       @db.VarChar(255)
  description         String?      @db.Text
  defaultBudgetHours  Decimal?     @map("default_budget_hours") @db.Decimal(10, 2)
  defaultBudgetAmount Decimal?     @map("default_budget_amount") @db.Decimal(14, 2)
  defaultPriority     TaskPriority @default(medium) @map("default_priority")
  phaseId             Int?         @map("phase_id")
  sortOrder           Int          @default(0) @map("sort_order")
  createdAt           DateTime     @default(now()) @map("created_at")

  template    Template     @relation(fields: [templateId], references: [id], onDelete: Cascade)
  serviceType ServiceType? @relation(fields: [serviceTypeId], references: [id])
  phase       Phase?       @relation(fields: [phaseId], references: [id])

  @@map("template_tasks")
}

model TemplateZone {
  id                   Int      @id @default(autoincrement())
  templateId           Int      @map("template_id")
  parentId             Int?     @map("parent_id")
  zoneType             ZoneType @default(zone) @map("zone_type")
  name                 String   @db.VarChar(255)
  code                 String?  @db.VarChar(50)
  isTypical            Boolean  @default(false) @map("is_typical")
  typicalCount         Int      @default(1) @map("typical_count")
  // Instance count — at apply time, instantiate this template-zone N times
  // (each becoming a separate, individually-renameable zone in the project).
  // Distinct from `typicalCount`, which marks a single zone in the project
  // as "typical" so the PM can later explode it manually. Default 1 = current
  // single-instance behaviour.
  instanceCount        Int      @default(1) @map("instance_count")
  sortOrder            Int      @default(0) @map("sort_order")
  linkedTaskTemplateId Int?     @map("linked_task_template_id")
  referencedTemplateId Int?     @map("referenced_template_id")
  createdAt            DateTime @default(now()) @map("created_at")

  template           Template           @relation(fields: [templateId], references: [id], onDelete: Cascade)
  parent             TemplateZone?      @relation("TemplateZoneTree", fields: [parentId], references: [id])
  children           TemplateZone[]     @relation("TemplateZoneTree")
  linkedTaskTemplate Template?          @relation("LinkedTaskTemplate", fields: [linkedTaskTemplateId], references: [id])
  referencedTemplate Template?          @relation("ReferencedZoneTemplate", fields: [referencedTemplateId], references: [id])
  templateZoneTasks  TemplateZoneTask[]

  @@map("template_zones")
}

model TemplateZoneTask {
  id                  Int          @id @default(autoincrement())
  templateZoneId      Int          @map("template_zone_id")
  serviceTypeId       Int?         @map("service_type_id")
  code                String       @db.VarChar(50)
  name                String       @db.VarChar(255)
  description         String?      @db.Text
  defaultBudgetHours  Decimal?     @map("default_budget_hours") @db.Decimal(10, 2)
  defaultBudgetAmount Decimal?     @map("default_budget_amount") @db.Decimal(14, 2)
  defaultPriority     TaskPriority @default(medium) @map("default_priority")
  phaseId             Int?         @map("phase_id")
  sortOrder           Int          @default(0) @map("sort_order")
  createdAt           DateTime     @default(now()) @map("created_at")

  templateZone TemplateZone @relation(fields: [templateZoneId], references: [id], onDelete: Cascade)
  serviceType  ServiceType? @relation(fields: [serviceTypeId], references: [id])
  phase        Phase?       @relation(fields: [phaseId], references: [id])

  @@map("template_zone_tasks")
}

// ─── Messaging ────────────────────────────────────────────────────────────────

model Message {
  id         Int               @id @default(autoincrement())
  entityType MessageEntityType @map("entity_type")
  entityId   Int               @map("entity_id")
  parentId   Int?              @map("parent_id")
  authorId   Int?              @map("author_id")
  type       MessageType       @default(user)
  content    String            @db.Text
  metadata   Json?
  isEdited   Boolean           @default(false) @map("is_edited")
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")
  deletedAt  DateTime?         @map("deleted_at")

  author        User?            @relation("MessageAuthor", fields: [authorId], references: [id])
  parent        Message?         @relation("MessageThread", fields: [parentId], references: [id])
  replies       Message[]        @relation("MessageThread")
  mentions      MessageMention[]
  notifications Notification[]

  @@index([entityType, entityId])
  @@index([parentId])
  @@index([authorId])
  @@index([createdAt])
  @@map("messages")
}

model MessageMention {
  id        Int      @id @default(autoincrement())
  messageId Int      @map("message_id")
  userId    Int      @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@unique([messageId, userId])
  @@index([userId])
  @@map("message_mentions")
}

model NotificationPreference {
  id               Int      @id @default(autoincrement())
  userId           Int      @map("user_id")
  notificationType String   @map("notification_type")
  inApp            Boolean  @default(true) @map("in_app")
  email            Boolean  @default(false)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, notificationType])
  @@index([userId])
  @@map("notification_preferences")
}

// ─── Business Partners ──────────────────────────────────────────────────────
//
// SAP-BP-inspired model: every person AND every organization (employee,
// customer, supplier, consultant, external contact, municipality, partner
// company, etc.) is a BusinessPartner. A BP can have multiple roles
// (employee + consultant), and multiple relationships to projects /
// organizations / etc. with their own context-specific role label.
//
// User remains the auth-bearing identity; a User row points to its BP via
// User.businessPartnerId. BPs without a User row are non-login partners.

model BusinessPartner {
  id           Int           @id @default(autoincrement())
  partnerType  PartnerType   @map("partner_type")
  displayName  String        @map("display_name") @db.VarChar(255)
  // Person-only (nullable for orgs)
  firstName    String?       @map("first_name") @db.VarChar(100)
  lastName     String?       @map("last_name") @db.VarChar(100)
  /// Optional Hebrew rendering — same rationale as on User. Bilingual
  /// search hits these too. (T3.3, 2026-06-28)
  firstNameHe  String?       @map("first_name_he") @db.VarChar(100)
  lastNameHe   String?       @map("last_name_he") @db.VarChar(100)
  // Org-typically (nullable for persons; persons can also have an
  // employer relationship — see PartnerRelationship)
  companyName  String?       @map("company_name") @db.VarChar(255)
  taxId        String?       @map("tax_id") @db.VarChar(50)
  // Common contact info
  // BM2 Phase 3 (2026-08-13): dropped @unique on email. Real data has
  // multiple contacts sharing an office inbox; identity for a BP is the
  // row + its owned domains (see BusinessPartnerDomain) + normalized
  // name, not the email. A non-unique index below still speeds lookups.
  email        String?       @db.VarChar(255)
  phone        String?       @db.VarChar(50)
  mobile       String?       @db.VarChar(50)
  address      String?       @db.VarChar(500)
  website      String?       @db.VarChar(255)
  linkedinUrl  String?       @map("linkedin_url") @db.VarChar(500)
  facebookUrl  String?       @map("facebook_url") @db.VarChar(500)
  twitterUrl   String?       @map("twitter_url") @db.VarChar(500)
  instagramUrl String?       @map("instagram_url") @db.VarChar(500)
  // Meta
  status       String        @default("active") @db.VarChar(20)
  source       PartnerSource @default(manual)
  notes        String?       @db.Text

  // Main Role — the single primary categorization of the contact
  // (Customer / Supplier / Consultant / Internal / ...). Optional so
  // legacy data doesn't break; the drawer surfaces a soft prompt when
  // null. Additional role contexts live on relationships, not here.
  // ON DELETE SET NULL — deleting a role-type unbinds it from BPs
  // rather than orphaning them.
  mainRoleTypeId Int?             @map("main_role_type_id")
  mainRoleType   PartnerRoleType? @relation("BusinessPartnerMainRole", fields: [mainRoleTypeId], references: [id], onUpdate: Cascade, onDelete: SetNull)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  user                  User?                       @relation("UserBusinessPartner")
  roles                 BusinessPartnerRole[]
  // BM2 Phase 1 (2026-08-13): `outgoingRelationships BusinessPartnerRelationship[]`
  // was removed with the legacy `business_partner_relationships` table.
  // party↔party edges live in `partnerRelationshipsA` / `partnerRelationshipsB`;
  // project participation lives in `projectPartnerRoles`.
  partnerRelationshipsA         PartnerRelationship[]       @relation("PartyAOnRel")
  partnerRelationshipsB         PartnerRelationship[]       @relation("PartyBOnRel")
  projectPartnerRoles           ProjectPartnerRole[]        @relation("PartyOnProjectRole")
  // BM2 Phase 2 (2026-08-13) — participation representation. Back-relations
  // for the two optional self-FKs on `project_partner_roles`.
  projectPartnerRolesAsContact  ProjectPartnerRole[]        @relation("ProjectPartnerRoleContactParty")
  projectPartnerRolesOnBehalfOf ProjectPartnerRole[]        @relation("ProjectPartnerRoleOnBehalfOf")
  // BM2 Phase 3 (2026-08-13) — multi-domain orgs. A BP (typically an
  // organization) may own several domains (office + secondary).
  domains                       BusinessPartnerDomain[]
  professions                   BusinessPartnerProfession[]

  /// If this partner row was created by a bulk import, track which import.
  /// Used by the data-import rollback flow. NULL for partners created via
  /// the regular UI or seeds. SET NULL on import-record delete.
  createdByImportId Int?        @map("created_by_import_id")
  createdByImport   DataImport? @relation("PartnersCreatedByImport", fields: [createdByImportId], references: [id], onDelete: SetNull)

  @@index([partnerType])
  @@index([status])
  @@index([companyName])
  @@index([deletedAt])
  @@index([mainRoleTypeId])
  @@index([createdByImportId])
  // BM2 Phase 3 — non-unique lookup index on email (the @unique was
  // dropped; the DB still needs fast lookups by email for import dedup
  // and worker-of-user backfill).
  @@index([email])
  @@map("business_partners")
}

// BM2 Phase 3 (2026-08-13) — multi-domain orgs.
// A BP (typically an organization) may own multiple domains. Import
// dedup matches company-by-domain first, then normalized name. Personal
// / free-email domains never bind an org — that list is maintained via
// PersonalEmailDomain (Phase 4).
model BusinessPartnerDomain {
  id        Int    @id @default(autoincrement())
  partnerId Int    @map("partner_id")
  domain    String @db.VarChar(255)

  partner BusinessPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@unique([domain])
  @@index([partnerId])
  @@map("business_partner_domains")
}

// Lookup table for what KIND of business roles a partner can hold.
// Predefined seeds: employee, customer, supplier, consultant,
// external_contact, subcontractor. Admins can add their own; system
// rows are protected from deletion (UI enforces; isSystem flag).
/// Catalog of role-type categories. Each PartnerRoleType belongs to at
/// most one category (a grouping label like 'cst' = Customer-side, 'int'
/// = Internal). Used to group roles on the UI and as a constraint in
/// relationship-type side-pickers (SideTarget.categoryCodes).
model PartnerRoleCategory {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(20)
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(500)
  color       String?  @db.VarChar(7) // hex like '#3B82F6' for chip background
  sortOrder   Int      @default(0) @map("sort_order")
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  roleTypes PartnerRoleType[] @relation("PartnerRoleTypeCategory")

  @@map("partner_role_categories")
}

model PartnerRoleType {
  id            Int                  @id @default(autoincrement())
  code          String               @unique @db.VarChar(50)
  name          String               @db.VarChar(100)
  description   String?              @db.VarChar(500)
  // Coarse grouping. References PartnerRoleCategory.code. The column
  // keeps the string code (not an FK to .id) so legacy JSON references in
  // SideTarget.categoryCodes / relationship-type side-pickers stay valid.
  // ON DELETE SET NULL — deleting a category unbinds it from role types
  // rather than cascading; the admin UI also blocks delete while in use.
  category      String?              @db.VarChar(20)
  categoryRef   PartnerRoleCategory? @relation("PartnerRoleTypeCategory", fields: [category], references: [code], onUpdate: Cascade, onDelete: SetNull)
  // Which kind of party can hold this role. 'person', 'organization', or
  // 'any' (default — the role can attach to either). Used by the
  // SidePickerCard to filter the role chip list so admins don't see
  // combinations that can never match real data (e.g. 'employee' on an
  // organization, 'supplier' on a person).
  appliesToKind String               @default("any") @map("applies_to_kind") @db.VarChar(20)
  sortOrder     Int                  @default(0) @map("sort_order")
  isSystem      Boolean              @default(false) @map("is_system")
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")

  roles          BusinessPartnerRole[]
  mainOfPartners BusinessPartner[]     @relation("BusinessPartnerMainRole")

  @@index([category])
  @@map("partner_role_types")
}

// Lookup table for what KIND of relationships a partner can have to a
// target. Predefined seeds (system, isSystem=true):
//   worker_of               — person → organization
//   customer_of_project     — organization (customer) → project
//   supplier_of_project     — organization (supplier) → project
//   participates_in_project — person → project (role_in_context = "Project Manager", etc.)
// Validation rules (applicableSourceType / applicableTargetTypes /
// requiredSourceRoleCode) are evaluated by the relationship service, so
// admins can define new types without code changes.
model PartnerRelationshipType {
  id          Int     @id @default(autoincrement())
  code        String  @unique @db.VarChar(50)
  name        String  @db.VarChar(100)
  description String? @db.VarChar(500)

  // ─── M3a — named sides (SAP-BUT050 + Salesforce hybrid) ────────────────
  // Each relationship type names what each side IS, so the form / lists
  // can read "Customer → Project Alpha" instead of "source → target".
  //
  //   sideALabel:  the role name of party A in the sentence
  //                  e.g. 'Employee'    for worker_of
  //                  e.g. 'Customer'    for customer_of_project
  //   sideBLabel:  the role name of party B
  //                  e.g. 'Employer'    for worker_of
  //                  e.g. 'Project'     for customer_of_project
  //   sideAKind:   what kind of entity is allowed on side A
  //                  'person' | 'organization' | 'any'
  //   sideBKind:   what kind of entity is allowed on side B
  //                  'person' | 'organization' | 'project' | 'any'
  //                  ('project' marks this row for migration to
  //                  ProjectPartnerRole in M3b — these aren't real
  //                  party↔party rels.)
  //   inverseLabel: how to label this rel when listed on side B
  //                  e.g. for worker_of, sideB sees "Employs"
  //   isSymmetric:  e.g. partner_of, joint_venture_with — same label both ways
  //   allowsMultiple: false ⇒ a single party can have at most one active
  //                  rel of this type (e.g. one primary employer at a time)
  sideALabel     String? @map("side_a_label") @db.VarChar(100)
  sideBLabel     String? @map("side_b_label") @db.VarChar(100)
  inverseLabel   String? @map("inverse_label") @db.VarChar(100)
  isSymmetric    Boolean @default(false) @map("is_symmetric")
  allowsMultiple Boolean @default(true) @map("allows_multiple")

  // M3.5 — structured side targets. Each side is a JSON array of allowed
  // (kind, optional role/category constraint) tuples; the relationship
  // accepts a party if it matches ANY of the entries on its side.
  //
  // Shape:
  //   [
  //     { "kind": "organization", "roleCodes": ["customer","supplier"] },
  //     { "kind": "project" }
  //   ]
  //
  //   kind:           'person' | 'organization' | 'project' | 'any'
  //   roleCodes:      optional. The party must hold ONE OF these
  //                   PartnerRoleType.code values. Ignored for kind='project'.
  //   categoryCodes:  optional. The party must hold a role whose
  //                   PartnerRoleType.category is in this list. Combined
  //                   with roleCodes via OR.
  //
  // BM2 Phase 1 (2026-08-13): the legacy single-shot columns
  //   sideAKind, sideBKind, applicableTargetTypes, applicableSourceType,
  //   requiredSourceRoleCode, requiredTargetRoleCode
  // were dropped alongside `business_partner_relationships` (the "M7"
  // cleanup). All validation now flows through sideATargets/sideBTargets.
  sideATargets Json? @map("side_a_targets")
  sideBTargets Json? @map("side_b_targets")

  sortOrder Int      @default(0) @map("sort_order")
  isSystem  Boolean  @default(false) @map("is_system")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // BM2 Phase 1 (2026-08-13): back-relation to the retired
  // BusinessPartnerRelationship model was removed with the table.
  partnerRelationships PartnerRelationship[]

  @@map("partner_relationship_types")
}

model BusinessPartnerRole {
  id                Int       @id @default(autoincrement())
  businessPartnerId Int       @map("business_partner_id")
  roleTypeId        Int       @map("role_type_id")
  isPrimary         Boolean   @default(false) @map("is_primary")
  validFrom         DateTime? @map("valid_from")
  validTo           DateTime? @map("valid_to")
  createdAt         DateTime  @default(now()) @map("created_at")

  partner  BusinessPartner @relation(fields: [businessPartnerId], references: [id], onDelete: Cascade)
  roleType PartnerRoleType @relation(fields: [roleTypeId], references: [id])

  @@unique([businessPartnerId, roleTypeId])
  @@index([businessPartnerId])
  @@index([roleTypeId])
  @@map("business_partner_roles")
}

// BM2 Phase 1 (2026-08-13): `BusinessPartnerRelationship` was retired.
// The polymorphic table `business_partner_relationships` split into two
// clean models:
//   • `partner_relationships`   (party↔party — BUT050 in one table)
//   • `project_partner_roles`   (project × party × role)
// Data was migrated by `20260813100000_bp_phase1_relationships_topoff`,
// the table + M7 legacy columns were dropped by
// `20260813100010_bp_phase1_drop_legacy_relationships`. See
// `docs/bm2/bp-model-refactor.md` for the migration plan.

// ─── Numbering & Foundation Catalogs ────────────────────────────────────────
//
// SAP NRIV-style number range. Each numbered object (Person, Organization,
// Employee, Project, …) draws its business code from a NumberRange row.
// NumberRangeService.next(objectCode) atomically increments currentNumber
// inside a row-locked transaction and returns a formatted string built from
// prefix + zero-padded number (padWidth). One range per (objectCode,
// rangeName); multiple named ranges per object are allowed (e.g. 'default'
// and 'external') so admins can carve out segments without code changes.

/// M1.1 — Pure sequence catalog. Each row is a named sequence with a
/// stable `code`. Other entities (Persons, Organizations, Employees,
/// Projects, …) reference a NumberRange.code via the EntityKind catalog
/// below to decide HOW their business code is assigned.
///
/// Mode controls write-side behaviour:
///   auto     — system allocates next number atomically on create.
///   manual   — user types the code at create time; uniqueness only.
///   external — same as manual but with an optional validation regex
///              (`externalPattern`). For codes coming from another system.
model NumberRange {
  id              Int      @id @default(autoincrement())
  code            String   @unique @db.VarChar(50)
  name            String?  @db.VarChar(100)
  mode            String   @default("auto") @db.VarChar(20)
  prefix          String   @default("") @db.VarChar(20)
  padWidth        Int      @default(8) @map("pad_width")
  fromNumber      BigInt   @default(1) @map("from_number")
  toNumber        BigInt   @default(99999999) @map("to_number")
  currentNumber   BigInt   @default(0) @map("current_number")
  externalPattern String?  @map("external_pattern") @db.VarChar(255)
  isActive        Boolean  @default(true) @map("is_active")
  description     String?  @db.VarChar(255)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  entityKinds EntityKind[] @relation("EntityKindRange")

  @@map("number_ranges")
}

/// M1.1 — Registry of "objects" that can be numbered (Persons, Organizations,
/// Employees, Projects, Contracts, …). Each entity kind points at one
/// NumberRange that determines how its codes are issued. Admins reassign
/// via the Object Numbering admin page; one number range can serve several
/// entity kinds.
model EntityKind {
  id              Int      @id @default(autoincrement())
  code            String   @unique @db.VarChar(50)
  name            String   @db.VarChar(100)
  description     String?  @db.VarChar(500)
  numberRangeCode String?  @map("number_range_code") @db.VarChar(50)
  sortOrder       Int      @default(0) @map("sort_order")
  isSystem        Boolean  @default(false) @map("is_system")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  numberRange NumberRange? @relation("EntityKindRange", fields: [numberRangeCode], references: [code], onUpdate: Cascade, onDelete: SetNull)

  @@map("entity_kinds")
}

// ISO-4217 currency catalog. Used for cost rates and any monetary value.
// Multiple currencies can coexist; cross-currency conversion (exchange
// rates) is a future enhancement — for now reports show per-currency
// subtotals.
model Currency {
  code      String   @id @db.VarChar(3) // 'ILS', 'USD', 'EUR'
  name      String   @db.VarChar(100)
  symbol    String?  @db.VarChar(10)
  decimals  Int      @default(2)
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("currencies")
}

// User-managed seniority ladder (Junior / Mid / Senior / Principal / …).
// Empty by default — each org defines their own. Used by EmployeeRole and
// the RoleCostRate matrix (added in M5).
model SeniorityLevel {
  id                Int      @id @default(autoincrement())
  code              String   @unique @db.VarChar(50)
  name              String   @db.VarChar(100)
  /// Default hourly cost for an employee at this seniority level. Used by
  /// project labor-cost calculations: cost = logged_minutes / 60 *
  /// employee.seniorityLevel.defaultHourlyCost. Nullable — admin fills
  /// in per organisation. Can be refined to a profession × seniority
  /// matrix later (M5 follow-up).
  defaultHourlyCost Decimal? @map("default_hourly_cost") @db.Decimal(10, 2)
  /// ISO-4217 currency code (FK currencies.code). When NULL, costs are
  /// treated as unitless on this seniority level.
  currency          String?  @db.VarChar(3)
  sortOrder         Int      @default(0) @map("sort_order")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  employees             User[]          @relation("UserSeniorityLevel")
  // Reverse side of UserSeniority — every historical assignment that
  // pointed at this level. Cascade SET NULL on delete so we never
  // orphan a row (but a level in use can't be hard-deleted from the UI
  // anyway).
  historicalAssignments UserSeniority[] @relation("SeniorityLevelHistory")

  @@map("seniority_levels")
}

/// Date-effective seniority history per user. Each row says "user X
/// held seniority level Y from startDate until endDate (or still
/// active if endDate is NULL)". The project labor-cost calculation
/// looks up the row whose [startDate, endDate] covers each time
/// entry's date, so the cost reflects the seniority that was active
/// AT THE TIME the work was logged — not the user's current level.
///
/// Constraints enforced by the service (not the DB) at save time:
///   1. startDate < endDate when both set.
///   2. No date-range overlap with any other row for the same user.
///   3. At most one open-ended (endDate=NULL) row per user.
///   4. Contiguous chain: when a new open-ended row is added with
///      startDate=S, the previous open-ended row is closed at S-1.
///
/// User.seniorityLevelId is kept in sync (= the level of the current
/// open-ended row, or the most recent closed row if none open). That's
/// the "convenience" field for read paths that don't care about
/// historical date-aware lookups; the source of truth lives here.
model UserSeniority {
  id               Int       @id @default(autoincrement())
  userId           Int       @map("user_id")
  seniorityLevelId Int       @map("seniority_level_id")
  /// Inclusive — the day the assignment begins.
  startDate        DateTime  @map("start_date") @db.Date
  /// Inclusive — the day the assignment ends. NULL = currently active
  /// (no planned end). At most one row per user can have endDate=NULL.
  endDate          DateTime? @map("end_date") @db.Date
  notes            String?   @db.Text
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user           User           @relation("UserSeniorityHistory", fields: [userId], references: [id], onDelete: Cascade)
  seniorityLevel SeniorityLevel @relation("SeniorityLevelHistory", fields: [seniorityLevelId], references: [id])

  @@unique([userId, startDate])
  @@index([userId, startDate])
  @@index([userId, endDate])
  @@map("user_seniorities")
}

// ─── M3b — Party↔Party + Project-Party-Role tables ─────────────────────────
//
// PartnerRelationship is the new BUT050-style party↔party model. Both sides
// are BusinessPartners (which become "Party" in M2 — column names already
// say party_*). Replaces the polymorphic targetType+targetId pattern from
// BusinessPartnerRelationship for org-targeted rows; project-targeted rows
// move to ProjectPartnerRole instead.
//
// The relationship type names what each side IS (sideALabel / sideBLabel
// on PartnerRelationshipType), so a row reads as a sentence:
// "Acme Ltd (Employer) ↔ John Doe (Employee)".

model PartnerRelationship {
  id        Int      @id @default(autoincrement())
  partyAId  Int      @map("party_a_id")
  partyBId  Int      @map("party_b_id")
  typeId    Int      @map("type_id")
  isPrimary Boolean  @default(false) @map("is_primary")
  // Contextual title at side B (e.g. 'CFO at Acme'). Plain text by design —
  // the structured part is the type + role catalogs.
  titleAtB  String?  @map("title_at_b") @db.VarChar(255)
  validFrom DateTime @default(now()) @map("valid_from")
  validTo   DateTime @default(dbgenerated("'9999-12-31 00:00:00'")) @map("valid_to")
  status    String   @default("active") @db.VarChar(20)
  notes     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  partyA BusinessPartner         @relation("PartyAOnRel", fields: [partyAId], references: [id], onDelete: Cascade)
  partyB BusinessPartner         @relation("PartyBOnRel", fields: [partyBId], references: [id], onDelete: Cascade)
  type   PartnerRelationshipType @relation(fields: [typeId], references: [id])

  @@unique([partyAId, partyBId, typeId, validFrom])
  @@index([partyAId])
  @@index([partyBId])
  @@index([typeId])
  @@map("partner_relationships")
}

// Catalog of roles a Party can hold on a Project — Customer, Supplier,
// Architect, Engineer, Inspector, … This is the project-side counterpart
// to PartnerRoleType (which is the partner-side catalog of customer /
// supplier / employee / etc.). Admins can extend; system rows protected.
model ProjectRoleType {
  id                      Int      @id @default(autoincrement())
  code                    String   @unique @db.VarChar(50)
  name                    String   @db.VarChar(100)
  description             String?  @db.VarChar(500)
  // Constrains which kind of party can hold this role on a project:
  // 'person' | 'organization' | 'any'.
  allowedPartnerKind      String   @default("any") @map("allowed_partner_kind") @db.VarChar(20)
  // If set, the party also has to hold this PartnerRoleType.code on its
  // party-role list (e.g. project Customer role requires the org to also
  // carry the 'customer' partner-role globally).
  requiredPartnerRoleCode String?  @map("required_partner_role_code") @db.VarChar(50)
  // M4a.3 — Required Job Titles (Profession ids). JSON array; when non-empty,
  // the party must hold at least one of these professions for the picker to
  // accept them. Empty/null = no profession constraint.
  requiredProfessionIds   Json?    @map("required_profession_ids")
  // If true, exactly one party can hold this role as PRIMARY on a project
  // (e.g. one primary Customer per project). Enforced at the service layer.
  isPrimaryRequired       Boolean  @default(false) @map("is_primary_required")
  sortOrder               Int      @default(0) @map("sort_order")
  isSystem                Boolean  @default(false) @map("is_system")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  roles ProjectPartnerRole[]

  @@map("project_role_types")
}

// Project × Party × Role — replaces the customer_of_project / supplier_of_project
// / participates_in_project rows in BusinessPartnerRelationship. The
// project FK is a real FK (no polymorphism), so listing "who is on this
// project" is now a straight join.
model ProjectPartnerRole {
  id             Int      @id @default(autoincrement())
  projectId      Int      @map("project_id")
  partyId        Int      @map("party_id")
  roleId         Int      @map("role_id")
  isPrimary      Boolean  @default(false) @map("is_primary")
  titleInProject String?  @map("title_in_project") @db.VarChar(255)
  // BM2 Phase 2 (2026-08-13) — representation on project participation:
  //   contactPartyId    → the PERSON who is the contact when this row's
  //                       party is an ORG (SAP "partner + contact person"
  //                       on a document).
  //   onBehalfOfPartyId → the ORG a PERSON represents on THIS project.
  //                       Pins the employer per-project for freelancers
  //                       and multi-employer people; otherwise the global
  //                       worker_of resolution is ambiguous.
  // Both are optional self-relations to BusinessPartner. Named
  // explicitly ("ProjectPartnerRoleContactParty" /
  // "ProjectPartnerRoleOnBehalfOf") so Prisma doesn't collide with the
  // existing PartyOnProjectRole relation on party_id.
  contactPartyId    Int?     @map("contact_party_id")
  onBehalfOfPartyId Int?     @map("on_behalf_of_party_id")
  validFrom      DateTime @default(now()) @map("valid_from")
  validTo        DateTime @default(dbgenerated("'9999-12-31 00:00:00'")) @map("valid_to")
  status         String   @default("active") @db.VarChar(20)
  notes          String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  project        Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  party          BusinessPartner  @relation("PartyOnProjectRole", fields: [partyId], references: [id], onDelete: Cascade)
  role           ProjectRoleType  @relation(fields: [roleId], references: [id])
  contactParty   BusinessPartner? @relation("ProjectPartnerRoleContactParty", fields: [contactPartyId], references: [id], onDelete: SetNull)
  onBehalfOfParty BusinessPartner? @relation("ProjectPartnerRoleOnBehalfOf", fields: [onBehalfOfPartyId], references: [id], onDelete: SetNull)

  @@unique([projectId, partyId, roleId, validFrom])
  @@index([projectId])
  @@index([partyId])
  @@index([roleId])
  @@index([contactPartyId])
  @@index([onBehalfOfPartyId])
  @@map("project_partner_roles")
}

// ─── F5 — Project Stage Milestones (Notion-style status board) ───────────
//
// Two tables:
//   • ProjectStageMilestone — admin-defined catalog of milestone columns
//     ("URS Submission", "Architectural Approval", "Stage 1", …). Order
//     drives the board column order; isActive=false hides without losing
//     history.
//   • ProjectMilestoneStatus — one row per (project, milestone). Boolean
//     completion + completedAt + free-text notes. Unique on the pair.
//
// Surfaced as a project-list-style board where each row = one project
// and each column = a milestone checkbox. Toggle writes through to
// ProjectMilestoneStatus immediately (no draft state).

model ProjectStageMilestone {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(150)
  /// Optional explanation surfaced in tooltip / drawer; e.g. "Customer
  /// signed off the URS and the doc is in the archive."
  description String?  @db.Text
  /// Column order on the board. Lower = leftmost.
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  statuses ProjectMilestoneStatus[]

  @@map("project_stage_milestones")
}

model ProjectMilestoneStatus {
  id          Int       @id @default(autoincrement())
  projectId   Int       @map("project_id")
  milestoneId Int       @map("milestone_id")
  isCompleted Boolean   @default(false) @map("is_completed")
  completedAt DateTime? @map("completed_at")
  completedBy Int?      @map("completed_by")
  notes       String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  project   Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone ProjectStageMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  @@unique([projectId, milestoneId])
  @@index([projectId])
  @@index([milestoneId])
  @@map("project_milestone_statuses")
}

// ─── M? — Bulk Data Import ───────────────────────────────────────────────
//
// Audit + rollback tracking for the bulk Excel import feature. One
// DataImport per upload; one DataImportRow per source-file row. Every
// entity created by an import is tagged with the DataImport.id via a
// `createdByImportId` column on the entity table — so rollback is just
// "delete all rows where createdByImportId = X" (for insert-only mode)
// or "restore beforeJson on rows updated by X" (for upsert, M2+).
//
// Permission gating uses 3 per-entity modules:
//   • data-import/users
//   • data-import/partners
//   • data-import/contacts
// All three are in NO_ADMIN_BYPASS — even admins must hold the explicit
// grant. Bulk imports can corrupt thousands of rows in seconds, so the
// permission must be deliberately granted, not inherited from Admin.

enum DataImportTarget {
  users
  partners
  contacts
  /// Whole-project migration from a legacy system (the BM migration).
  /// Touches many entity types in one run — projects, zones, tasks,
  /// assignments, time entries — so rollback uses the generic ImportLog
  /// table below rather than per-entity createdByImportId columns.
  projects
}

enum DataImportStatus {
  parsed // file uploaded + parsed, awaiting commit
  committed // commit ran successfully
  partial // commit ran with some errors
  failed // commit aborted with no rows written
  rolled_back // rollback ran successfully
}

enum DataImportMode {
  insert // skip existing (default)
  upsert // update existing + create new (M2+)
  update // only touch existing
}

model DataImport {
  id           Int              @id @default(autoincrement())
  userId       Int              @map("user_id")
  target       DataImportTarget
  /// Original filename as uploaded by the user. Only for display in the
  /// history page — we never read the source file back; everything we
  /// need is captured in DataImportRow.
  filename     String           @db.VarChar(255)
  /// SHA-256 of the file bytes. Used to detect duplicate uploads (same
  /// user, same file, within a short window) so a double-click doesn't
  /// create two parallel import runs.
  fileHash     String           @map("file_hash") @db.VarChar(64)
  mode         DataImportMode
  rowCount     Int              @map("row_count")
  createdCount Int              @default(0) @map("created_count")
  updatedCount Int              @default(0) @map("updated_count")
  skippedCount Int              @default(0) @map("skipped_count")
  errorCount   Int              @default(0) @map("error_count")
  status       DataImportStatus
  /// When set, rollback is no longer available — past this point the row
  /// is read-only history. Default 30 days from finishedAt.
  expiresAt    DateTime?        @map("expires_at")
  startedAt    DateTime         @default(now()) @map("started_at")
  finishedAt   DateTime?        @map("finished_at")
  rolledBackAt DateTime?        @map("rolled_back_at")
  /// Free-text describing the column mapping used + any user-supplied
  /// notes (e.g. "imported from HR spreadsheet 2026-Q2"). Plain text.
  notes        String?          @db.Text

  user User            @relation("DataImportRunner", fields: [userId], references: [id], onDelete: Restrict)
  rows DataImportRow[]

  // Reverse side of entity tagging — every user/partner row whose
  // createdByImportId matches this import. Wired via the SET NULL FKs on
  // the entity tables so deleting an import doesn't delete the entities
  // it once created (only un-tags them).
  usersCreated    User[]            @relation("UsersCreatedByImport")
  partnersCreated BusinessPartner[] @relation("PartnersCreatedByImport")
  // Audit log used by the projects-target rollback flow (BM migration).
  // Catalog rows are recorded with action='linked' and skipped on
  // rollback; everything else is deleted in reverse sortOrder.
  logs            ImportLog[]       @relation("ImportLogs")

  @@index([userId])
  @@index([target])
  @@index([status])
  @@index([startedAt])
  @@map("data_imports")
}

/// Generic audit row written by the BM-style whole-project importer.
/// One row per entity touched by the run. Lets rollback walk DESC by
/// sortOrder and delete in FK-safe order without adding a
/// `createdByImportId` column to every table the importer might touch.
/// Catalog entries (phase, service, profession, department) are logged
/// with action='linked' so rollback skips them — they're shared.
model ImportLog {
  id         Int        @id @default(autoincrement())
  importId   Int        @map("import_id")
  import     DataImport @relation("ImportLogs", fields: [importId], references: [id], onDelete: Cascade)
  /// Snake-case entity name: 'project' / 'zone' / 'task' /
  /// 'project_deliverable' / 'task_assignee' / 'time_entry' /
  /// 'user' / 'business_partner' / 'phase' / 'service' / 'profession' /
  /// 'department'.
  entityType String     @map("entity_type") @db.VarChar(50)
  /// PK of the row created/linked. Resolved against entityType at
  /// rollback time so we can call the right prisma model's delete.
  entityId   Int        @map("entity_id")
  /// 'created' — delete on rollback.
  /// 'linked'  — pre-existing or shared catalog row; rollback skips it.
  /// 'updated' — touched an existing row; we keep before-state in notes
  ///             so rollback can restore (M2+; for now we just don't undo).
  action     String     @db.VarChar(20)
  /// Monotonic within the run — rollback walks DESC so children of a
  /// hierarchy (timeentry → assignee → task → deliverable → zone →
  /// project) are deleted before their parents.
  sortOrder  Int        @default(0) @map("sort_order")
  /// Optional free-text — the source-row index, the entity's natural
  /// key, anything that makes the audit row readable in retrospect.
  notes      String?    @db.Text
  createdAt  DateTime   @default(now()) @map("created_at")

  @@index([importId, sortOrder])
  @@index([entityType, entityId])
  @@map("import_logs")
}

enum DataImportRowOutcome {
  created
  updated
  skipped
  failed
}

model DataImportRow {
  id           Int                  @id @default(autoincrement())
  importId     Int                  @map("import_id")
  /// 1-based index in the source file (after header row). Used to point
  /// the user at the exact spreadsheet row when reporting errors.
  rowIndex     Int                  @map("row_index")
  outcome      DataImportRowOutcome
  /// The PK of the created/updated entity in its respective table.
  /// NULL when outcome is skipped/failed. We don't constrain this with
  /// an FK because the entity table varies by import.target (users,
  /// partners, contacts) — the import.target field tells you which.
  entityId     Int?                 @map("entity_id")
  errorMessage String?              @map("error_message") @db.Text
  /// JSON snapshot of the entity BEFORE this import touched it. Only
  /// populated for `updated` outcomes. Used by rollback to restore the
  /// prior state. NULL for created/skipped/failed.
  beforeJson   Json?                @map("before_json")
  /// JSON of what we tried to write (parsed and normalized). Always
  /// present so the per-row report shows exactly what was processed.
  afterJson    Json?                @map("after_json")
  createdAt    DateTime             @default(now()) @map("created_at")

  import DataImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([importId])
  @@index([outcome])
  @@map("data_import_rows")
}

/// Organizational hierarchy. Single-parent tree, one manager per unit,
/// one home unit per employee (see User.orgUnitId). Managers see their
/// own unit's subtree at unlimited depth via ProjectAccessService.
///
/// `path` is the materialised ancestry line — "/1/5/12/" — INCLUDING
/// this unit's own id. Subtree lookups use `path startsWith parent.path`
/// so a single indexed scan replaces recursive CTEs. `depth` is derived
/// from `path` (= depth-of-parent + 1) and kept in sync by
/// OrgUnitService.
///
/// Additive + nullable across the board — until admins actually place
/// people in units and set managers, ZERO behavior changes in the
/// existing access-control paths. Ownership is soft-deleted (deletedAt)
/// not hard-deleted so historical assignments stay resolvable.
model OrgUnit {
  id            Int       @id @default(autoincrement())
  name          String
  code          String?   @unique
  parentId      Int?      @map("parent_id")
  parent        OrgUnit?  @relation("OrgUnitTree", fields: [parentId], references: [id])
  children      OrgUnit[] @relation("OrgUnitTree")
  managerUserId Int?      @map("manager_user_id")
  manager       User?     @relation("OrgUnitManager", fields: [managerUserId], references: [id], onDelete: SetNull)
  /// Materialised path, e.g. "/1/5/12/". Always starts and ends with
  /// "/". Includes the unit's own id as the tail segment. Rewritten by
  /// OrgUnitService.move whenever a subtree changes parent.
  path          String    @default("/")
  depth         Int       @default(0)
  sortOrder     Int       @default(0) @map("sort_order")
  deletedAt     DateTime? @map("deleted_at")
  members       User[]    @relation("UserOrgUnit")

  @@index([parentId])
  @@index([path])
  @@index([managerUserId])
  @@map("org_units")
}

// ─── SSO / Identity ────────────────────────────────────────────────
//
// P1 — infrastructure + Microsoft Entra ID. Google + Entra App-Roles
// are deferred to P2/P3.
//
// OrgAuthConfig holds one row per (organization × provider). Today
// Planwise is single-company, so organizationId is nullable and there
// is effectively one row per provider. The client-secret is stored as
// AES-256-GCM (ciphertext + iv + tag + keyVersion) — never plaintext,
// never in application logs, never in an API response.
//
// UserIdentity binds a Planwise User to a stable IdP subject (e.g.
// Entra `oid`) — NOT email. Emails change; subjects don't. The unique
// (provider, subject) index is what OidcUserResolverService.byIdentity()
// looks up on every SSO login.

model OrgAuthConfig {
  id               Int      @id @default(autoincrement())
  /// Nullable — Planwise is single-company at P1; the column exists
  /// so a future multi-tenant model can add a per-tenant configuration
  /// without another migration.
  organizationId   Int?     @map("organization_id")
  /// 'microsoft' | 'google' (google gated to P2). Enforced by the DTO
  /// validator, not the DB, so a future provider can be added without
  /// schema churn.
  provider         String   @db.VarChar(20)
  enabled          Boolean  @default(false)
  /// Entra tenant id (GUID). Nullable — Google doesn't use one.
  tenantId         String?  @map("tenant_id") @db.VarChar(191)
  clientId         String   @map("client_id") @db.VarChar(191)
  /// AES-256-GCM(ciphertext | iv | tag | keyVersion). Written and read
  /// EXCLUSIVELY through SecretCryptoService — never touch the raw
  /// bytes elsewhere.
  secretCiphertext Bytes    @map("secret_ciphertext")
  secretIv         Bytes    @map("secret_iv")
  secretTag        Bytes    @map("secret_tag")
  keyVersion       Int      @map("key_version")
  /// CSV of allowed email domains for JIT provisioning. Enforced BEFORE
  /// any user create/link. Kept as a plain string (comma-separated) for
  /// admin ergonomics; the resolver splits and trims.
  allowedDomains   String   @default("") @map("allowed_domains") @db.VarChar(500)
  /// Fallback role assigned when the resolver JIT-creates a new user
  /// from an SSO callback. FK so a role rename doesn't strand configs.
  defaultRoleId    Int      @map("default_role_id")
  /// When true, users with allowPasswordLogin=false are hard-blocked
  /// from the /auth/login path — even a valid bcrypt hash won't let
  /// them in. Enforced in AuthService.validateUser.
  ssoOnly          Boolean  @default(false) @map("sso_only")
  updatedBy        Int?     @map("updated_by")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  defaultRole Role @relation(fields: [defaultRoleId], references: [id])

  @@unique([organizationId, provider])
  @@map("org_auth_configs")
}

model UserIdentity {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  provider  String   @db.VarChar(20)
  /// The IdP-side stable subject (`oid` for Entra, `sub` for Google).
  /// This is the ONLY safe primary lookup key — email can change on
  /// the IdP side without notice and would break linkage.
  subject   String   @db.VarChar(191)
  /// Snapshot of the email the IdP presented at link time. Purely
  /// informational for admin debug ("which mailbox was this?") —
  /// NEVER used as a lookup key.
  email     String?  @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@index([userId])
  @@map("user_identities")
}

// ─── Google Drive Integration ──────────────────────────────────────
//
// OrgDriveConfig — one row per organization; holds the service-account
// JSON key (AES-256-GCM via SecretCryptoService, never plaintext) and
// the customer-provided Shared-Drive ID. Planwise CREATES + READS
// folders/files inside this Shared Drive using the service account but
// NEVER writes permissions — end-user access is governed by the
// customer's own Shared-Drive membership in Google. See
// modules/drive/drive.service.ts for the invariant and the enforced
// call-shape (supportsAllDrives + Shared-Drive scoping).
//
// DriveFolderLink — cache of (entityType, entityId) → folderId so we
// don't re-search the Shared Drive on every open. Unique index on the
// pair makes ensureFolder idempotent.
model OrgDriveConfig {
  id             Int      @id @default(autoincrement())
  /// Nullable — Planwise is single-company at P1; column exists so a
  /// future multi-tenant model can add per-tenant configs without a
  /// migration. Mirrors OrgAuthConfig.organizationId.
  organizationId Int?     @map("organization_id")
  enabled        Boolean  @default(false)
  /// AES-256-GCM(saCiphertext | saIv | saTag | keyVersion) — the
  /// service-account JSON key. Written and read EXCLUSIVELY through
  /// SecretCryptoService; never touch the raw bytes elsewhere.
  saCiphertext   Bytes    @map("sa_ciphertext")
  saIv           Bytes    @map("sa_iv")
  saTag          Bytes    @map("sa_tag")
  keyVersion     Int      @map("key_version")
  /// Google Shared-Drive ID (`0AGxxx...`) the customer's Workspace
  /// admin gives us. ALL Drive operations are scoped to this id.
  sharedDriveId  String   @map("shared_drive_id") @db.VarChar(191)
  /// Optional folder INSIDE the Shared Drive to use as the root for
  /// project folders. When null, project folders live at the top of
  /// the Shared Drive itself.
  rootFolderId   String?  @map("root_folder_id") @db.VarChar(191)
  updatedBy      Int?     @map("updated_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([organizationId])
  @@map("org_drive_configs")
}

model DriveFolderLink {
  id          Int      @id @default(autoincrement())
  /// 'project' | 'zone' | 'deliverable' — enforced by the service.
  /// Kept as a plain string so we can add more entity types without
  /// schema churn.
  entityType  String   @map("entity_type") @db.VarChar(20)
  entityId    Int      @map("entity_id")
  /// Google Drive folder id (`1abcXYZ...`).
  folderId    String   @map("folder_id") @db.VarChar(191)
  /// The Drive `webViewLink` for the folder — user-facing URL.
  webViewLink String?  @map("web_view_link") @db.VarChar(1000)
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([entityType, entityId])
  @@map("drive_folder_links")
}
