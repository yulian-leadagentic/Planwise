  timeClock TimeClock? @relation(fields: [timeClockId], references: [id])
  project   Project?   @relation(fields: [projectId], references: [id])
  task      Task?      @relation(fields: [taskId], references: [id])

  @@index([userId])
  @@index([timeClockId])
  @@index([projectId])
  @@index([taskId])
  @@index([date])
  @@index([deletedAt])
  @@map("time_entries")
}

