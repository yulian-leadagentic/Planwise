generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum UserType {
  employee
  partner
  both
}

enum PartnerType {
  person
  organization
}

enum PartnerSource {
  manual
  import
  google
  outlook
  system
}

// RelationshipTarget enum retired in BM2 Phase 1 (2026-08-13).
// The polymorphic `business_partner_relationships` table was split into
// `partner_relationships` (party↔party) + `project_partner_roles`
// (project × party × role); neither uses this enum. Kept the comment
// as a bread-crumb — if a future migration needs the enum, resurrect
// it explicitly rather than reintroducing polymorphism.

enum ProjectStatus {
  draft
  active
  on_hold
  completed
  cancelled
}

enum TaskStatus {
  not_started
  in_progress
  in_review
  completed
  on_hold
  cancelled
}

enum TaskPriority {
  low
  medium
  high
  critical
}

enum CalendarDayType {
  holiday
  company_day_off
  half_day
  special
}

enum CalendarDayAppliesTo {
  all
  employees_only
  partners_only
}

enum TimeClockStatus {
  clocked_in
  completed
  auto_closed
  edited
  absent
  leave
  sick
}

enum ClockType {
  regular
  overtime
  remote
  field
}

enum ContractStatus {
  draft
  active
  completed
  cancelled
}

enum BillingType {
  generated
  requested
}

enum BillingStatus {
  draft
  sent
  approved
  paid
  rejected
}

enum ExpenseType {
  material
  labor
  travel
  equipment
  subcontractor
  other
}

enum ActivityCategory {
  auth
  project
  task
  time
  contract
  user
  system
  admin
  partner
}

enum ActivitySeverity {
  info
  warn
  error
  critical
}

enum EmailLogStatus {
  sent
  failed
}

enum ProjectRole {
  project_leader        @map("project_leader")
  bim_manager           @map("bim_manager")
  bim_lead              @map("bim_lead")
  mep_coordinator       @map("mep_coordinator")
  mep_lead              @map("mep_lead")
  coordinator
  professional_employee @map("professional_employee")
  viewer
}

enum ZoneType {
  site
  building
  level
  zone
  area
  section
  wing
  floor
}

// Editable presentation metadata for the ZoneType enum. The enum itself is
// the source of truth for which values are allowed (zones reference it by
// value), but admins can customise the displayed label, color, icon, and
// sort order without a code change. Rows are seeded 1:1 with the enum and
// the admin UI exposes edit-only — no add, no delete — so it stays in
// lockstep with the enum at all times.
model ZoneTypeMeta {
  id        Int      @id @default(autoincrement())
  code      String   @unique @db.VarChar(32)
  label     String   @db.VarChar(64)
  color     String   @db.VarChar(7)
  icon      String?  @db.VarChar(32)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("zone_type_meta")
}

enum TemplateType {
  task_list @map("task_list")
  zone
  combined
}

enum MessageEntityType {
  project
  task
  zone
}

enum MessageType {
  user
  system
}

// ─── Models ─────────────────────────────────────────────────────────────────

model User {
  id                 Int             @id @default(autoincrement())
  /// Business code (employee number). Allocated from the EMPLOYEE entity
  /// kind's number range at user create time. Mode determines who supplies
  /// it: auto = system, manual/external = user. Nullable for backward
  /// compat with users created before M1.1.
  code               String?         @unique @db.VarChar(50)
  email              String          @unique
  /// Nullable because SSO-only users have no local password. Legacy
  /// password-login continues to work for rows that still have a hash;
  /// AuthService.validateUser rejects a login attempt on a null-password
  /// row with a message that nudges the user toward SSO. Flip
  /// allowPasswordLogin=false to lock a specific user to SSO even when
  /// a stale hash lingers.
  password           String?
  allowPasswordLogin Boolean         @default(true) @map("allow_password_login")
  firstName          String          @map("first_name")
  lastName           String          @map("last_name")
  /// Optional Hebrew rendering of the user's name. The search query
  /// matches against EITHER the English columns above OR these, so an
  /// admin can find "Yossi" by typing either "yossi" or "יוסי".
  /// (T3.3, 2026-06-28)
  firstNameHe        String?         @map("first_name_he") @db.VarChar(100)
  lastNameHe         String?         @map("last_name_he") @db.VarChar(100)
  phone              String?
  avatarUrl          String?         @map("avatar_url")
  roleId             Int             @map("role_id")
  userType           UserType        @map("user_type")
  position           String?
  department         String?
  companyName        String?         @map("company_name")
  taxId              String?         @map("tax_id")
  address            String?
  salaryHourly       Decimal?        @map("salary_hourly") @db.Decimal(10, 2)
  dailyStandardHours Decimal?        @map("daily_standard_hours") @db.Decimal(4, 2)
  employmentDate     DateTime?       @map("employment_date") @db.Date
  employmentEndDate  DateTime?       @map("employment_end_date") @db.Date
  employeeCategory   String?         @map("employee_category")
  /// Employee seniority level. Used to look up the default hourly cost
  /// for project labor calculations. Nullable for backward compat and for
  /// non-employee users who have no cost concept.
  /// Source-of-truth for date-effective cost is `user_seniorities` (the
  /// history table). This column reflects the user's CURRENT seniority
  /// (most recent open-ended row) and is kept in sync via the service
  /// so existing reads (employee table, edit form, etc.) keep working.
  /// Will be dropped in a future cleanup once every reader is migrated
  /// to date-aware lookups.
  seniorityLevelId   Int?            @map("seniority_level_id")
  seniorityLevel     SeniorityLevel? @relation("UserSeniorityLevel", fields: [seniorityLevelId], references: [id], onDelete: SetNull)
  // Full history of seniority assignments per user — see UserSeniority.
  seniorityHistory   UserSeniority[] @relation("UserSeniorityHistory")
  website            String?
  otpCode            String?         @map("otp_code")
  otpExpiresAt       DateTime?       @map("otp_expires_at")
  otpAttempts        Int             @default(0) @map("otp_attempts")
  isActive           Boolean         @default(true) @map("is_active")
  lastLoginAt        DateTime?       @map("last_login_at")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")
  deletedAt          DateTime?       @map("deleted_at")

  // Bridge to the Business Partner record. A User is a BP that also has
  // login credentials. Most BPs (orgs, external contacts who never log in)
  // won't have a User row.
  businessPartnerId Int?             @unique @map("business_partner_id")
  businessPartner   BusinessPartner? @relation("UserBusinessPartner", fields: [businessPartnerId], references: [id], onDelete: SetNull)

  role Role @relation(fields: [roleId], references: [id])

  projectsCreated       Project[]                @relation("ProjectCreatedBy")
  projectsLed           Project[]                @relation("ProjectLeader")
  projectMembers        ProjectMember[]
  taskAssignees         TaskAssignee[]
  taskComments          TaskComment[]
  workSchedules         WorkSchedule[]
  calendarDaysCreated   CalendarDay[]            @relation("CalendarDayCreatedBy")
  timeClocks            TimeClock[]              @relation("TimeClockUser")
  timeClocksApproved    TimeClock[]              @relation("TimeClockApprovedBy")
  timeClocksEdited      TimeClock[]              @relation("TimeClockEditedBy")
  timeEntries           TimeEntry[]
  contractsAsPartner    Contract[]               @relation("ContractPartner")
  contractsCreated      Contract[]               @relation("ContractCreatedBy")
  milestonesAsPartner   LabelMilestone[]         @relation("MilestonePartner")
  milestonesCreated     LabelMilestone[]         @relation("MilestoneCreatedBy")
  contacts              Contact[]
  expensesCreated       Expense[]
  terms                 Term[]
  activityLogs          ActivityLog[]
  notifications         Notification[]
  billingsCreated       Billing[]
  teamTemplates         TeamTemplate[]
  teamTemplateMembers   TeamTemplateMember[]
  tasksCreated          Task[]                   @relation("TaskCreator")
  checklistItemsCreated TaskChecklistItem[]      @relation("ChecklistCreator")
  checklistItemsDone    TaskChecklistItem[]      @relation("ChecklistDoneBy")
  taskReviewActions     TaskReviewEvent[]        @relation("TaskReviewActor")
  taskOpsNotesUpdated   TaskOpsNote[]            @relation("TaskOpsNoteUpdater")
  templatesCreated      Template[]               @relation("TemplateCreator")
  messages              Message[]                @relation("MessageAuthor")
  messageMentions       MessageMention[]
  taskAttachments       TaskAttachment[]
  projectFiles          ProjectFile[]
  notificationsActed    Notification[]           @relation("NotificationActor")
  notificationPrefs     NotificationPreference[]
  resourceOverrides     ResourceOverride[]       @relation("UserResourceOverrides")

  /// Bulk-import provenance + history. createdByImportId tags users that
  /// were created by an import (used for rollback); dataImportsRun is
  /// the reverse of who ran an import. Two unrelated fields, kept
  /// together so the import wiring is in one place on the User model.
  createdByImportId Int?         @map("created_by_import_id")
  createdByImport   DataImport?  @relation("UsersCreatedByImport", fields: [createdByImportId], references: [id], onDelete: SetNull)
  dataImportsRun    DataImport[] @relation("DataImportRunner")

  /// Home org unit — where this employee "sits" in the org chart. A
  /// user has exactly zero or one home unit (a single OrgUnit id).
  /// Nullable + additive: zero behavior change until admins actually
  /// place people in units. Managed via OrgUnitService.assignUser.
  orgUnitId    Int?      @map("org_unit_id")
  orgUnit      OrgUnit?  @relation("UserOrgUnit", fields: [orgUnitId], references: [id], onDelete: SetNull)
  /// Units this user MANAGES. Under the org-access model, exactly one
  /// manager per unit; the reverse relation is 0..N per user because a
  /// single person can manage multiple sibling units. A manager's view
  /// expands to their unit's ENTIRE subtree via the `path` startsWith
  /// query in ProjectAccessService.getManagedSubtreeUnitIds.
  managedUnits OrgUnit[] @relation("OrgUnitManager")

  /// External IdP identity links (Microsoft, Google, …). One user can
  /// hold multiple identities (e.g. Microsoft work account + Google
  /// personal). The (provider, subject) pair is the stable IdP-side
  /// key — NEVER email — so a renamed mailbox doesn't lose its user.
  identities UserIdentity[]

  @@index([roleId])
  @@index([email])
  @@index([userType])
  @@index([isActive])
  @@index([deletedAt])
  @@index([createdByImportId])
  @@index([orgUnitId])
  @@map("users")
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users             User[]
  roleModules       RoleModule[]
  stageTransitions  RoleStageTransition[]
  resourceOverrides ResourceOverride[]
  orgAuthConfigs    OrgAuthConfig[]

  @@map("roles")
}

model Module {
  id        Int      @id @default(autoincrement())
  name      String
  route     String   @unique
  icon      String?
  sortOrder Int      @default(0) @map("sort_order")
  parentId  Int?     @map("parent_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  parent   Module?  @relation("ModuleParent", fields: [parentId], references: [id])
  children Module[] @relation("ModuleParent")

  roleModules RoleModule[]

  @@index([parentId])
  @@map("modules")
}

model RoleModule {
  id         Int     @id @default(autoincrement())
  roleId     Int     @map("role_id")
  moduleId   Int     @map("module_id")
  canRead    Boolean @default(false) @map("can_read")
  canWrite   Boolean @default(false) @map("can_write")
  canDelete  Boolean @default(false) @map("can_delete")
  canApprove Boolean @default(false) @map("can_approve")
  canExport  Boolean @default(false) @map("can_export")

  role   Role   @relation(fields: [roleId], references: [id])
  module Module @relation(fields: [moduleId], references: [id])

  @@index([roleId])
  @@index([moduleId])
  @@map("role_modules")
}

// ─── Fine-grained RBAC: stage transitions + resource overrides ──────

/// Controls which Kanban status transitions a role is allowed to perform.
/// If NO rows exist for a role, the role can perform ALL transitions (backward
/// compatible). Once ANY row exists for a role, only the listed transitions
/// are allowed — unlisted moves are blocked.
model RoleStageTransition {
  id         Int    @id @default(autoincrement())
  roleId     Int    @map("role_id")
  fromStatus String @map("from_status") @db.VarChar(30)
  toStatus   String @map("to_status") @db.VarChar(30)

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, fromStatus, toStatus])
  @@index([roleId])
  @@map("role_stage_transitions")
}

/// Per-resource permission overrides. Can ONLY narrow the default role-module
/// permission — never widen. If a row exists for a resource + role/user, its
/// flags replace the module-level flags for that specific resource.
model ResourceOverride {
  id           Int     @id @default(autoincrement())
  resourceType String  @map("resource_type") @db.VarChar(30)
  resourceId   Int     @map("resource_id")
  roleId       Int?    @map("role_id")
  userId       Int?    @map("user_id")
  canRead      Boolean @default(true) @map("can_read")
  canWrite     Boolean @default(false) @map("can_write")
  canDelete    Boolean @default(false) @map("can_delete")

  role Role? @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user User? @relation("UserResourceOverrides", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([resourceType, resourceId, roleId, userId])
  @@index([resourceType, resourceId])
  @@index([roleId])
  @@index([userId])
  @@map("resource_overrides")
}

model ProjectType {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  code      String?  @db.VarChar(20)
  color     String?  @db.VarChar(7)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  projects Project[]

  @@map("project_types")
}

model Department {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  code      String?  @db.VarChar(20)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  projects Project[]

  @@map("departments")
}

/// "Job Title" in the UI. Represents what a person DOES by trade
/// (Architect, BIM Manager, Site Engineer, ...). Linked to people via
/// `business_partner_professions`. Distinct from PartnerRoleType
/// (what someone IS to the business) and ProjectRoleType (what someone
/// DOES on a specific project).
model Profession {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  partners BusinessPartnerProfession[]

  @@map("professions")
}

/// Person × Profession join. One person can hold several professions;
/// one may be marked primary. Independent of the project-role table —
/// professions are a classification of the person regardless of which
/// project they're working on.
model BusinessPartnerProfession {
  id                Int       @id @default(autoincrement())
  businessPartnerId Int       @map("business_partner_id")
  professionId      Int       @map("profession_id")
  isPrimary         Boolean   @default(false) @map("is_primary")
  since             DateTime? @db.Date
  notes             String?   @db.VarChar(255)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  businessPartner BusinessPartner @relation(fields: [businessPartnerId], references: [id], onDelete: Cascade)
  profession      Profession      @relation(fields: [professionId], references: [id], onDelete: Cascade)

  @@unique([businessPartnerId, professionId])
  @@index([businessPartnerId])
  @@index([professionId])
  @@map("business_partner_professions")
}

model ProjectRoleTemplate {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("project_role_templates")
}

/// PROJECT — the central object every other table hangs off. `closedAt`
/// gates project-list visibility; the (closed_at) index supports the
/// hot path "list active projects" query.
model Project {
  id                       Int           @id @default(autoincrement())
  name                     String
  number                   String?
  description              String?
  projectTypeId            Int           @map("project_type_id")
  departmentId             Int?          @map("department_id")
  leaderId                 Int?          @map("leader_id")
  status                   ProjectStatus @default(draft)
  budget                   Decimal?      @db.Decimal(14, 2)
  estimatedValue           Decimal?      @map("estimated_value") @db.Decimal(14, 2)
  startDate                DateTime?     @map("start_date")
  endDate                  DateTime?     @map("end_date")
  isArchived               Boolean       @default(false) @map("is_archived")
  /// Free-text version of the authoring tool used on this project (e.g.
  /// "Revit 2024.2", "ArchiCAD 27"). Replaces the old single-purpose
  /// "Revit version" concept now that the company uses multiple tools.
  /// Surfaced on the Project Info tab and editable from the project
  /// edit form.
  authoringToolVersion     String?       @map("authoring_tool_version") @db.VarChar(100)
  /// Day of the weekly project meeting, free text ("Tuesday 10:00",
  /// "Sundays after standup"). Surfaced on the Project Info tab.
  weeklyMeetingDay         String?       @map("weekly_meeting_day") @db.VarChar(100)
  /// File-management system + hub link for the project ("BIM 360 — link",
  /// "OneDrive: https://..."). Free text by design — different
  /// customers use different vendors.
  fileSystemLink           String?       @map("file_system_link") @db.VarChar(500)
  /// What we deliver to this customer per the contract — free text.
  /// Plain-text summary for the Project Info tab; the structured part
  /// lives in deliverables.
  servicesPerContract      String?       @map("services_per_contract") @db.Text
  /// Per-project display-name overrides for Deliverable groups, keyed
  /// by deliverableTemplateId (the Template's id, as a string). When a
  /// deliverable group is rendered on the planning grid, the label
  /// resolves from this map first, falling back to the source
  /// Template.name when no override exists. Lets the same template
  /// (e.g. "BIM Foundation") be re-labelled per-project (e.g. "Tower A
  /// Foundation") without forking the template catalog. Stored as JSON
  /// so we don't need a join table for what's effectively a small
  /// per-project KV.
  deliverableNameOverrides Json?         @map("deliverable_name_overrides")
  createdBy                Int           @map("created_by")
  createdAt                DateTime      @default(now()) @map("created_at")
  updatedAt                DateTime      @updatedAt @map("updated_at")
  deletedAt                DateTime?     @map("deleted_at")
  /// When set, the project is CLOSED — finished and excluded from the
  /// default project list (the UI surfaces a "Show closed" toggle for
  /// when someone needs to find one). Distinct from `deletedAt` (soft
  /// delete) and `isArchived` (legacy boolean retained for back-compat);
  /// closing is the user-facing "I'm done with this" action.
  closedAt                 DateTime?     @map("closed_at")

  projectType ProjectType @relation(fields: [projectTypeId], references: [id])
  department  Department? @relation(fields: [departmentId], references: [id])
  creator     User        @relation("ProjectCreatedBy", fields: [createdBy], references: [id])
  leader      User?       @relation("ProjectLeader", fields: [leaderId], references: [id])

  members           ProjectMember[]
  labels            Label[]
  contracts         Contract[]
  expenses          Expense[]
  timeEntries       TimeEntry[]
  zones             Zone[]
  tasks             Task[]
  categories        ProjectCategory[]
  files             ProjectFile[]
  partnerRoles      ProjectPartnerRole[]
  milestoneStatuses ProjectMilestoneStatus[]
  deliverables      ProjectDeliverable[]

  @@index([projectTypeId])
  @@index([departmentId])
  @@index([createdBy])
  @@index([leaderId])
  @@index([status])
  @@index([deletedAt])
  @@index([closedAt])
  @@map("projects")
}

model ProjectMember {
  id        Int      @id @default(autoincrement())
  projectId Int      @map("project_id")
  userId    Int      @map("user_id")
  role      String?
  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@map("project_members")
}

model Label {
  id          Int       @id @default(autoincrement())
  projectId   Int       @map("project_id")
  parentId    Int?      @map("parent_id")
  labelTypeId Int?      @map("label_type_id")
  name        String
  path        String
  depth       Int       @default(0)
  sortOrder   Int       @default(0) @map("sort_order")
  description String?
  color       String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  project  Project @relation(fields: [projectId], references: [id])
  parent   Label?  @relation("LabelParent", fields: [parentId], references: [id])
  children Label[] @relation("LabelParent")

  contractItems ContractItem[]
  milestones    LabelMilestone[]

  @@index([projectId])
  @@index([parentId])
  @@index([labelTypeId])
  @@index([deletedAt])
  @@map("labels")
}

model WorkSchedule {
  id             Int       @id @default(autoincrement())
  userId         Int       @map("user_id")
  name           String
  dayOfWeek      Int       @map("day_of_week")
  shiftStart     String    @map("shift_start")
  shiftEnd       String    @map("shift_end")
  breakMinutes   Int       @default(60) @map("break_minutes")
  isActive       Boolean   @default(true) @map("is_active")
  effectiveFrom  DateTime  @map("effective_from")
  effectiveUntil DateTime? @map("effective_until")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, dayOfWeek, effectiveFrom])
  @@index([userId])
  @@map("work_schedules")
}

model CalendarDay {
  id           Int                  @id @default(autoincrement())
  date         DateTime             @unique
  name         String
  type         CalendarDayType
  halfDayUntil String?              @map("half_day_until")
  appliesTo    CalendarDayAppliesTo @default(all) @map("applies_to")
  isRecurring  Boolean              @default(false) @map("is_recurring")
  notes        String?
  createdBy    Int                  @map("created_by")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")

  creator User @relation("CalendarDayCreatedBy", fields: [createdBy], references: [id])

  @@index([createdBy])
  @@map("calendar_days")
}

model TimeClock {
  id              Int             @id @default(autoincrement())
  userId          Int             @map("user_id")
  date            DateTime
  clockIn         DateTime        @map("clock_in")
  clockOut        DateTime?       @map("clock_out")
  breakMinutes    Int             @default(0) @map("break_minutes")
  status          TimeClockStatus
  clockType       ClockType       @default(regular) @map("clock_type")
  note            String?
  documentUrl     String?         @map("document_url")
  approvedBy      Int?            @map("approved_by")
  approvedAt      DateTime?       @map("approved_at")
  editedBy        Int?            @map("edited_by")
  editedReason    String?         @map("edited_reason")
  totalMinutes    Int?            @map("total_minutes")
  expectedMinutes Int?            @map("expected_minutes")
  overtimeMinutes Int?            @map("overtime_minutes")
  isLate          Boolean         @default(false) @map("is_late")
  lateMinutes     Int             @default(0) @map("late_minutes")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  user     User  @relation("TimeClockUser", fields: [userId], references: [id])
  approver User? @relation("TimeClockApprovedBy", fields: [approvedBy], references: [id])
  editor   User? @relation("TimeClockEditedBy", fields: [editedBy], references: [id])

  timeEntries TimeEntry[]

  @@index([userId])
  @@index([userId, date])
  @@index([approvedBy])
  @@index([editedBy])
  @@index([date])
  @@index([status])
  @@map("time_clock")
}

model TimeEntry {
  id            Int       @id @default(autoincrement())
  userId        Int       @map("user_id")
  timeClockId   Int?      @map("time_clock_id")
  projectId     Int?      @map("project_id")
  taskId        Int?      @map("task_id")
  date          DateTime
