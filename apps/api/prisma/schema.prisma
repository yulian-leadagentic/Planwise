// ─── Tasks ─────────────────────────────────────────────────────────────────

model Task {
  id                    Int          @id @default(autoincrement())
  // Tasks can attach directly to a project (zoneId = null) — used for
  // project-level deliverables/tasks that aren't tied to a spatial zone.
  // The planning grid renders these in a "Project Root" group above any
  // zoned tasks. Cascade-delete still fires for zone deletion since the
  // FK is the relation, not this scalar — the relation below is now
  // optional and uses SetNull semantics via Prisma.
  zoneId                Int?         @map("zone_id")
  projectId             Int          @map("project_id")
  serviceTypeId         Int?         @map("service_type_id")
  // Source Deliverable (Template with type=task_list). Direct FK so
  // the planning grid's "Group by Deliverable" can label cards by the
  // same name shown on /templates/deliverables. ServiceType is kept
  // alongside as a legacy fallback for tasks that pre-date this column.
  deliverableTemplateId Int?         @map("deliverable_template_id")
  // Project-owned deliverable (first-class instance). This is the
  // AUTHORITATIVE link going forward — its name/order/status belong to
  // the project (and are what the PM and customer see). deliverableTemplateId
  // is kept as the catalog provenance + back-compat for legacy readers.
  projectDeliverableId  Int?         @map("project_deliverable_id")
  code                  String       @db.VarChar(50)
  name                  String       @db.VarChar(255)
  description           String?      @db.Text
  budgetHours           Decimal?     @map("budget_hours") @db.Decimal(10, 2)
  budgetAmount          Decimal?     @map("budget_amount") @db.Decimal(14, 2)
  phaseId               Int?         @map("phase_id")
  status                TaskStatus   @default(not_started)
  priority              TaskPriority @default(medium)
  completionPct         Int          @default(0) @map("completion_pct")
  // Estimated start date — forecast set during planning, separate from
  // startDate (which is the *actual* date work began).
  estimatedStartDate    DateTime?    @map("estimated_start_date") @db.Date
  startDate             DateTime?    @map("start_date") @db.Date
  endDate               DateTime?    @map("end_date") @db.Date
  sortOrder             Int          @default(0) @map("sort_order")
  isArchived            Boolean      @default(false) @map("is_archived")
  createdBy             Int          @map("created_by")
  createdAt             DateTime     @default(now()) @map("created_at")
  updatedAt             DateTime     @updatedAt @map("updated_at")
  deletedAt             DateTime?    @map("deleted_at")

  zone                Zone?            @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  project             Project          @relation(fields: [projectId], references: [id])
  serviceType         ServiceType?     @relation(fields: [serviceTypeId], references: [id])
  phase               Phase?           @relation(fields: [phaseId], references: [id])
  deliverableTemplate Template?        @relation("TaskDeliverableTemplate", fields: [deliverableTemplateId], references: [id], onDelete: SetNull)
  projectDeliverable  ProjectDeliverable? @relation(fields: [projectDeliverableId], references: [id], onDelete: SetNull)
  creator             User             @relation("TaskCreator", fields: [createdBy], references: [id])
  assignees           TaskAssignee[]
  comments            TaskComment[]
  attachments         TaskAttachment[]
  timeEntries         TimeEntry[]
  dependencies        TaskDependency[] @relation("TaskDeps")
  dependedBy          TaskDependency[] @relation("TaskDepBy")
  checklistItems      TaskChecklistItem[]

  @@index([zoneId])
  @@index([projectId])
  @@index([serviceTypeId])
  @@index([projectDeliverableId])
  @@index([status])
  @@map("tasks")
}

/// Checklist items inside a Task. Per the 2026-06-14 BM mapping meeting
/// these are NOT separate tasks — no due date, no logged hours, no
/// status workflow. Just a list of things to tick off as the task
/// progresses (the "phone the architect; send the updated grid; verify
/// permits" sublist style). doneBy/doneAt are populated when isDone
/// flips to true so the team can see WHO actually closed each item.
model TaskChecklistItem {
  id        Int       @id @default(autoincrement())
  taskId    Int       @map("task_id")
  text      String    @db.VarChar(500)
  isDone    Boolean   @default(false) @map("is_done")
  doneAt    DateTime? @map("done_at")
  doneBy    Int?      @map("done_by")
  sortOrder Int       @default(0) @map("sort_order")
  createdBy Int       @map("created_by")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  task        Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  doneByUser  User? @relation("ChecklistDoneBy", fields: [doneBy], references: [id], onDelete: SetNull)
  creator     User  @relation("ChecklistCreator", fields: [createdBy], references: [id])

  @@index([taskId])
  @@index([deletedAt])
  @@map("task_checklist_items")
}

/// A project-owned Deliverable instance. Instantiated from a catalog
/// Template (sourceTemplateId) but its name/description/order/status
/// belong to the project — this is what the PM manages and the customer
/// sees. The catalog Template is never mutated; the project instance
/// diverges freely. Tasks link here via Task.projectDeliverableId.
model ProjectDeliverable {
  id               Int       @id @default(autoincrement())
  projectId        Int       @map("project_id")
  /// Catalog Template (type=task_list) this was instantiated from. Null
  /// for project-only deliverables with no catalog source.
  sourceTemplateId Int?      @map("source_template_id")
  /// The Service (Phase) line this deliverable belongs to. Inherited from
  /// the source template's phase; editable per project.
  serviceId        Int?      @map("service_id")
  name             String    @db.VarChar(255)
  description      String?   @db.Text
  sortOrder        Int       @default(0) @map("sort_order")
  status           String    @default("active") @db.VarChar(30)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceTemplate Template? @relation("DeliverableSourceTemplate", fields: [sourceTemplateId], references: [id], onDelete: SetNull)
  service        Phase?    @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  tasks          Task[]

  @@index([projectId])
  @@index([sourceTemplateId])
  @@map("project_deliverables")
}

model TaskAttachment {
  id         Int      @id @default(autoincrement())
  taskId     Int      @map("task_id")
  fileName   String   @map("file_name") @db.VarChar(255)
  fileUrl    String   @map("file_url") @db.VarChar(500)
  fileSize   Int?     @map("file_size")
